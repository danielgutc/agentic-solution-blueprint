# Adapt paths and language-specific extraction before using this template.
PROJECT_NAME = "Project API"
INPUT = ../../implementation/<unit>/src
RECURSIVE = YES
OUTPUT_DIRECTORY = ../../implementation/<unit>/artifacts/docs/doxygen
GENERATE_XML = YES
XML_OUTPUT = xml
GENERATE_HTML = NO
GENERATE_LATEX = NO
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
WARN_IF_UNDOCUMENTED = YES
WARN_AS_ERROR = YES
QUIET = YES
