    {
      "id": "alternate",
      "title": "Shared library alternate compile profile",
      "implementation_unit": "shared-library",
      "doxygen_version": "1.18.0",
      "doxyfile": "../doxygen-generic/Doxyfile",
      "doxygen_xml": "../doxygen-generic/xml",
