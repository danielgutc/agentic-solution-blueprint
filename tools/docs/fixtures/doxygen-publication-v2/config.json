  "profiles": [
    {
      "id": "default",
      "title": "Shared library default profile",
      "implementation_unit": "shared-library",
      "doxygen_version": "1.18.0",
      "doxyfile": "../doxygen-generic/Doxyfile",
      "doxygen_xml": "../doxygen-generic/xml",
      "code_fence_language": "csharp",
      "parser_limitations": [
        "Only public/protected class, interface, and struct compounds are in the generic fixture scope."
      ],
      "source_coverage": {
        "included": ["src/Example.Api/**/*.cs"],
        "excluded": [
          {
            "scope": "src/Example.Api/Internal/**",
            "reason": "Private helpers are outside the exported contract."
          }
        ]
      },
      "inventory_evidence": "docs/exported-api.txt",
      "symbols": [
        {
          "key": "example-api-iclock",
          "qualified_name": "Example.Api.IClock",
          "api_scope": "example-api",
          "selectors": {
            "compound_ids": ["interface_example_api_iclock"]
          }
        },
        {
          "key": "example-api-clockservice",
          "qualified_name": "Example.Api.ClockService",
          "api_scope": "example-api",
          "selectors": {
            "qualified_names": ["Example.Api.ClockService"]
          }
        }
      ],
      "bindings": [
        {
          "symbol_key": "example-api-iclock",
          "role": "provided-interface",
          "interface_scope": "external-runtime",
          "container_id": "sample",
          "component_id": "example",
          "narrative": "The component implements the container's externally exposed time contract."
        },
        {
          "symbol_key": "example-api-iclock",
          "role": "provided-interface",
          "interface_scope": "internal-component",
          "container_id": "sample",
          "component_id": "example",
          "narrative": "The same declaration is also the component port used inside the container."
        },
        {
          "symbol_key": "example-api-iclock",
          "role": "consumed-interface",
          "interface_scope": "internal-component",
          "container_id": "sample",
          "component_id": "consumer"
        },
        {
          "symbol_key": "example-api-iclock",
          "role": "consumed-interface",
          "interface_scope": "internal-component",
          "container_id": "reporting",
          "component_id": "report-reader"
        },
        {
          "symbol_key": "example-api-clockservice",
          "role": "owned-implementation",
          "container_id": "sample",
          "component_id": "example"
        },
        {
          "symbol_key": "example-api-clockservice",
          "role": "supporting-code",
          "container_id": "reporting"
        }
      ],
      "compatibility_stubs": [
        {
          "path": "design/c4/containers/sample/components/example/api/example-api/example-api-iclock.md",
          "symbol_key": "example-api-iclock"
        }
      ],
      "legacy_stub_roots": [
        "design/c4/containers/sample/components/example/api"
      ]
