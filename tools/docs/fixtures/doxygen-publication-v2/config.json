      {
        "id": "reporting",
        "title": "Reporting container",
        "output_dir": "design/c4/containers/reporting",
        "architecture_page": "design/c4/containers/reporting/container.md"
      }
    ],
    "components": [
      {
        "id": "example",
        "container_id": "sample",
        "title": "Example component",
        "output_dir": "design/c4/containers/sample/components/example",
        "architecture_page": "design/c4/containers/sample/components/example/component.md"
      },
      {
        "id": "consumer",
        "container_id": "sample",
        "title": "Consumer component",
